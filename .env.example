NODE_ENV=development
DATABASE_URL=postgresql://iom:iom@localhost:5432/iom

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

COOKIE_SECRET=replace-with-at-least-32-characters

API_PORT=3001
PLATFORM_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3001

STORAGE_ROOT=./storage
WORKER_CONCURRENCY=3
JOB_LEASE_SECONDS=60

OCR_LANGUAGES=ind+eng
ANVIA_LENS_ENABLED=false

CLASSIFIER_MODEL_ID=gpt-5.6-sol
OVERLAP_MODEL_ID=gpt-5.6-sol

# Optional: JSON array of ModelOption entries (see packages/contracts) that
# REPLACES the built-in model catalog. Use this when OPENAI_BASE_URL points to
# an OpenAI-compatible gateway whose model ids differ from the built-in ones.
# MALFORMED JSON falls back to the built-in catalog.
# MODEL_CATALOG_OVERRIDE=[{"id":"gpt-5.6-luna","label":"Luna","description":"...","supportedReasoningEfforts":["none"],"defaultReasoningEffort":"none","supportsStreaming":true,"supportsTools":true,"supportsReasoningSummary":false}]
